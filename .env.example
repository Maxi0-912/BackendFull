# Django
SECRET_KEY=change-this-to-a-long-random-secret-key
# DEBUG=True SOLO en tu maquina de desarrollo. En cualquier servidor: False.
DEBUG=False
# True si el servidor tiene https (Railway, dominio propio). False solo en un servidor de pruebas sin certificado.
HTTPS=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos MySQL
DB_NAME=tutalleraunclic
DB_USER=root
DB_PASSWORD=changeme
DB_HOST=localhost
DB_PORT=3306

# CORS (solo se usa cuando DEBUG=False)
CORS_ALLOWED_ORIGINS=https://miapp.example.com,https://admin.example.com

# CSRF (solo se usa cuando DEBUG=False)
CSRF_TRUSTED_ORIGINS=https://miapp.example.com,https://admin.example.com

# Google Sign-In
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Cloudinary (solo se usa cuando DEBUG=False)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Limite de intentos en login/registro/refresh (opcional)
THROTTLE_AUTH=10/min
THROTTLE_AUTH_REFRESH=20/min
